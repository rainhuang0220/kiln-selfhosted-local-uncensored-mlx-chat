{
  "name": "kiln",
  "private": true,
  "version": "0.5.0",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd backend && ../.venv/bin/uvicorn app.main:app --reload --host 127.0.0.1 --port 8787",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "test": "bash tests/test_fetch_model.sh && bash tests/test_activate_model.sh && cd backend && ../.venv/bin/pytest -q",
    "start:mlx": "bash scripts/start-mlx.sh",
    "start:api": "bash scripts/start-api.sh",
    "start:web": "bash scripts/start-web.sh",
    "start:local": "bash scripts/install-local-runtime.sh",
    "fetch:model": "bash scripts/fetch-model.sh",
    "start:mtplx": "bash scripts/start-mtplx.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
